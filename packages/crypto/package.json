{
  "name": "@itd-api/crypto",
  "version": "0.1.0",
  "description": "Плагин шифрования и стеганографии для itd-api",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KiowDev/itd-api.git",
    "directory": "packages/crypto"
  },
  "homepage": "https://kiowdev.github.io/itd-api/packages/crypto",
  "bugs": {
    "url": "https://github.com/KiowDev/itd-api/issues"
  },
  "author": "Kiow",
  "keywords": [
    "itd",
    "итд",
    "itd-api",
    "plugin",
    "steganography",
    "cipher",
    "zero-width"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:pack": "publint && attw --pack .",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build && npm run check:pack"
  },
  "peerDependencies": {
    "itd-api": ">=0.8.0 <1.0.0"
  },
  "peerDependenciesMeta": {
    "itd-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^26.2.0",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
