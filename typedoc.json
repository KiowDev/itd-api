{
  "$schema": "https://typedoc.org/schema.json",

  // Точка входа, tsconfig, имя и каталог задаются scripts/build-docs.mjs
  // отдельно для каждого публичного npm entry point.
  "readme": "none",
  "includeVersion": true,

  "plugin": [
    "typedoc-plugin-markdown",
    "typedoc-vitepress-theme"
  ],
  "docsRoot": "guides/web",
  "sidebar": {
    "autoConfiguration": true,
    "format": "vitepress",
    "collapsed": true,
    "pretty": true
  },
  "cleanOutputDir": true,
  "hideBreadcrumbs": false,
  "useCodeBlocks": true,

  "excludeInternal": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "categorizeByGroup": true,
  "externalSymbolLinkMappings": {
    "itd-api": {
      "RequestOptionKeysComplete": "#"
    }
  },

  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  }
}
